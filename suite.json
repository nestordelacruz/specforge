{
  "spec_title": "SpecForge Target API",
  "spec_version": "0.1.0",
  "tests": [
    {
      "id": "register_positive",
      "description": "Register a new user with valid email and password succeeds and returns role 'user'.",
      "case_type": "positive",
      "spec_ref": "POST /auth/register",
      "method": "POST",
      "path": "/auth/register",
      "auth": "none",
      "setup": [],
      "path_params": null,
      "query_params": null,
      "body": "{\"email\": \"register.positive@example.com\", \"password\": \"validpassword123\"}",
      "content_type": "json",
      "expected_status": 201,
      "expected_body_contains": "{\"email\": \"register.positive@example.com\", \"role\": \"user\"}"
    },
    {
      "id": "register_duplicate_email",
      "description": "Registering with an email that is already registered returns 409.",
      "case_type": "negative",
      "spec_ref": "POST /auth/register 409",
      "method": "POST",
      "path": "/auth/register",
      "auth": "none",
      "setup": [
        {
          "method": "POST",
          "path": "/auth/register",
          "auth": "none",
          "content_type": "json",
          "body": "{\"email\": \"register.duplicate@example.com\", \"password\": \"validpassword123\"}",
          "capture": null,
          "bind_to": null
        }
      ],
      "path_params": null,
      "query_params": null,
      "body": "{\"email\": \"register.duplicate@example.com\", \"password\": \"anotherpassword\"}",
      "content_type": "json",
      "expected_status": 409,
      "expected_body_contains": null
    },
    {
      "id": "register_invalid_email",
      "description": "Registering with a malformed email returns 422.",
      "case_type": "negative",
      "spec_ref": "components.schemas.UserCreate.email",
      "method": "POST",
      "path": "/auth/register",
      "auth": "none",
      "setup": [],
      "path_params": null,
      "query_params": null,
      "body": "{\"email\": \"not-an-email\", \"password\": \"validpassword123\"}",
      "content_type": "json",
      "expected_status": 422,
      "expected_body_contains": null
    },
    {
      "id": "register_password_min_boundary",
      "description": "Password of exactly 8 characters (minLength) is accepted.",
      "case_type": "boundary",
      "spec_ref": "components.schemas.UserCreate.password minLength",
      "method": "POST",
      "path": "/auth/register",
      "auth": "none",
      "setup": [],
      "path_params": null,
      "query_params": null,
      "body": "{\"email\": \"register.pwmin@example.com\", \"password\": \"12345678\"}",
      "content_type": "json",
      "expected_status": 201,
      "expected_body_contains": null
    },
    {
      "id": "register_password_below_min",
      "description": "Password of 7 characters, below minLength, is rejected with 422.",
      "case_type": "boundary",
      "spec_ref": "components.schemas.UserCreate.password minLength",
      "method": "POST",
      "path": "/auth/register",
      "auth": "none",
      "setup": [],
      "path_params": null,
      "query_params": null,
      "body": "{\"email\": \"register.pwbelow@example.com\", \"password\": \"1234567\"}",
      "content_type": "json",
      "expected_status": 422,
      "expected_body_contains": null
    },
    {
      "id": "register_password_max_boundary",
