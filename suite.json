          "content_type": "json",
          "body": "{\"email\": \"token.positive@example.com\", \"password\": \"validpassword123\"}",
          "capture": null,
          "bind_to": null
        }
      ],
      "path_params": null,
      "query_params": null,
      "body": "{\"grant_type\": \"password\", \"username\": \"token.positive@example.com\", \"password\": \"validpassword123\"}",
      "content_type": "form",
      "expected_status": 200,
      "expected_body_contains": "{\"token_type\": \"bearer\"}"
    },
