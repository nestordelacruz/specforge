# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-key-here

# Target service
DATABASE_URL=sqlite:///./specforge.db
JWT_SECRET=change-me-in-local-dev
TOKEN_EXPIRE_MINUTES=30

# Generator settings
# No temperature setting: sampling parameters are removed on current Claude
# models. Output structure is guaranteed by a strict schema instead.
CLAUDE_MODEL=claude-sonnet-5
